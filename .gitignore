# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# content/properties: raw source marketing binaries (brochures, CGIs, photos,
# videos, drive-export zips) and the image-processing output. These are local
# source material only, processed by scripts/ into public/images + the
# developmentAssets manifest, which ARE committed. Recursive globs catch these
# at any nesting depth / folder name (Images/, Show Apartment/, Drone Footage/,
# Brochure-Investment Deck/, extracted-images/, ...). The small per-development
# listing data (data.json, *.txt, *.md) stays tracked.
content/properties/**/*.pdf
content/properties/**/*.png
content/properties/**/*.jpg
content/properties/**/*.jpeg
content/properties/**/*.zip
content/properties/**/*.mp4
content/properties/extracted/
